# 配置模板：在 backend 目录复制为 .env.local 后填写；此模板本身不会被加载。
# 后端从项目根目录或 backend 目录启动时自动读取 backend/.env.local。
# KEY=value 格式，值不加引号；注释单独占一行。
# 按 Java properties 解析，字面反斜杠须写成两个反斜杠。

# demo：模拟演示；live：真实调用，可能产生费用。
TRAVEL_MODE=demo
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_API_KEY=
SEARCH_BASE_URL=https://api.bochaai.com/v1
BOCHA_API_KEY=
# default：内置 H2；mysql：启用下方数据库配置。
DB_PROFILE=default
DB_URL=jdbc:mysql://localhost:3306/aitravel?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai
DB_USERNAME=aitravel
DB_PASSWORD=
# 可选管理员：账号不存在且两项均填写时创建；密码至少12字符、最多72字节。
ADMIN_USERNAME=
ADMIN_PASSWORD=
# 可选单价：留空表示未知；模型每百万token，博查每次成功请求，统一币种。
DEEPSEEK_INPUT_PRICE=
DEEPSEEK_OUTPUT_PRICE=
BOCHA_PRICE_PER_REQUEST=
PRICE_CURRENCY=CNY
